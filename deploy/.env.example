# Copy to .env and edit. Never commit the result.

# ── required ─────────────────────────────────────────────────────────────────

# PostgreSQL superuser password for the bundled database.
POSTGRES_PASSWORD=change-me

# Bootstrap admin password. Used only while the users table is empty; after the
# first account exists this value is ignored, so rotate it in the UI, not here.
DSHF_ADMIN_PASSWORD=change-me

# ── usually edited ───────────────────────────────────────────────────────────

# Absolute base URL browsers use to reach the control plane. Set this to your
# real origin before exposing anything: cookie scope and the uplink URL that
# `dshf node add` prints are both derived from it.
DSHF_PUBLIC_URL=http://localhost:8080

# Host interface the published port binds to. The default keeps the control
# plane on loopback so a fresh `docker compose up` is not reachable from the
# LAN before you have put TLS and a proxy in front of it.
# Set to 0.0.0.0 only behind a reverse proxy you control.
DSHF_BIND=127.0.0.1

# ── optional ─────────────────────────────────────────────────────────────────

POSTGRES_DB=dshfleet
POSTGRES_USER=dshfleet
DSHF_ADMIN_USER=admin
DSHF_VERSION=dev
DSHF_LOG_LEVEL=info
