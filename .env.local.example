# Local (non-Docker) development environment for `go run ./cmd/dshf serve`.
#
# These match the cluster `pixi run setup` creates: port 5433, trust auth,
# database and role both named dshfleet.
#
# PowerShell:
#   Get-Content .env.local | ForEach-Object {
#     if ($_ -match '^\s*([A-Z_]+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] }
#   }
#   go run ./cmd/dshf serve
#
# bash:
#   set -a && . ./.env.local && set +a && go run ./cmd/dshf serve

DSHF_DATABASE_URL=postgres://dshfleet@127.0.0.1:5433/dshfleet?sslmode=disable
DSHF_LISTEN=127.0.0.1:8080
DSHF_PUBLIC_URL=http://127.0.0.1:8080
DSHF_MIGRATIONS_DIR=deploy/migrations
DSHF_ADMIN_USER=admin
DSHF_ADMIN_PASSWORD=dev-only-change-me
DSHF_LOG_LEVEL=debug
